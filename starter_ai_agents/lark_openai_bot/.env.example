# Lark custom app credentials
LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# Optional for encrypted webhook/event configurations.
# Long-connection mode can leave these blank unless configured in Lark.
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=

# OpenAI API
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5

# Bot behavior
BOT_NAME=Leo AI
REQUIRE_MENTION_IN_GROUP=true
MAX_OUTPUT_TOKENS=1200
ALLOWED_OPEN_IDS=
